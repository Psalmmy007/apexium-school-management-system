{
  "name": "apexium-school-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Apexium School Management System — multi-tenant ERP",
  "scripts": {
    "dev": "pnpm --filter @apexium/web dev",
    "build": "pnpm --filter @apexium/web build",
    "lint": "pnpm --filter @apexium/web lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @apexium/web run test:e2e",
    "db:generate": "pnpm --filter @apexium/db run generate",
    "db:migrate": "pnpm --filter @apexium/db run migrate",
    "db:studio": "pnpm --filter @apexium/db run studio",
    "platform:operator": "tsx scripts/provision-platform-operator.ts"
  },
  "devDependencies": {
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
