{
  "name": "@apexium/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background job worker for Apexium School ERP (BullMQ + Redis)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@apexium/db": "workspace:*",
    "@apexium/types": "workspace:*",
    "bullmq": "^5.13.0",
    "ioredis": "^5.4.1",
    "pdfkit": "^0.15.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.4",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
