# ── Supabase ───────────────────────────────────────────────────
# Get these from your Supabase project dashboard:
# Project Settings → API → Project URL and anon/service_role keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Database ───────────────────────────────────────────────────
# Direct Postgres connection string for Drizzle ORM (migrations & server queries)
# Get this from Supabase: Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler for the app, "Session" pooler for migrations
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Redis (for BullMQ worker) ──────────────────────────────────
# Local: redis://localhost:6379
# Production: use Upstash or a managed Redis service
REDIS_URL=redis://localhost:6379
