# pnpm configuration for Apexium School ERP

# Approve build scripts for packages that compile native binaries.
# These are well-known, safe packages: esbuild (JS bundler used by Next.js/Vite),
# msgpackr-extract (binary serialisation), unrs-resolver (Rust-based module resolver).
approved-builds=esbuild,msgpackr-extract,unrs-resolver
